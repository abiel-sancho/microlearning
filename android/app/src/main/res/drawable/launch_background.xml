<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de abertura (splash) até o Flutter desenhar o primeiro quadro:
     fundo violeta do app com o logo no centro (etapa 39). Antes: tela branca. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_fundo" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/logoapp" />
    </item>
</layer-list>
